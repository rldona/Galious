 "messages": [
  {
   "id": 0,
   "text": "IF YOUR LOVER IS\nKILLED,COME BACK\nHERE WITH {arrows}x100,\n{coins}x100 AND {keys}x20.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 1,
   "text": "SEE A FAIRY TO\nRESTORE YOUR\nVITALITY.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 2,
   "text": "GIVE ME {arrows}x100,\n{coins}x100 AND {keys}x20 IN\nRETURN FOR REVIVING\nYOUR LOVER.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 3,
   "text": "YOUR LOVER HAS\nREVIVED.GO AND GET\nBACK THE LITTLE BABY\nTOGETHER.GO AHEAD!",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 4,
   "text": "THEN,YOU MUST FIGHT\nALL BY YOURSELF.\nGO,RIGHT NOW.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 5,
   "text": "YOU CAN BUY SOME OF\nMY TREASURE.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 6,
   "text": "TAKE A MINE WITH YOU\nWHEN YOU GO TO\nWORLD 4.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 7,
   "text": "HIT THE WALL WITH\nYOURE SWORD IF YOU\nWANT TO GO TO THE\nOPPOSITE SHORE.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 8,
   "text": "APHRODITE.DO NOT BE\nAFRAID OF WATER.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 9,
   "text": "THE PURE WATER IS\nINSIDE THE WALL.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 10,
   "text": "HIT THE WALL WHEN\nYOU ARE HALFWAY OF\nTHE STAIRS.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 11,
   "text": "A GATE WHICH LEARDS\nTO GALIOUS WILL\nAPPEAR SOMEWHERE IN\nTHE CASTLE.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 12,
   "text": "YOU WANT THE SECRET\nCODE TO WAKEN\nMY MEMORY KEEP THE\nRECORDS ABOUT YOU?",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 13,
   "text": "YES         NO",
   "row": 9,
   "col": 9,
   "used": true
  },
  {
   "id": 14,
   "text": "RESCUE THE BABY AS\nQUICKLY AS POSSIBLE.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 15,
   "text": "DID YOU GET THEM?\n   YES",
   "row": 8,
   "col": 6,
   "used": true
  },
  {
   "id": 16,
   "text": "SEE YOU AGAIN.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 17,
   "text": "YOU SHALL HAVE SOME\nBREAD AND WATER.\nEVERYTIME YOU DEFCAT\nA DEVIL.",
   "row": 5,
   "col": 6,
   "used": false
  },
  {
   "id": 18,
   "text": "COINS ARE NOT\nENOUGH.",
   "row": 5,
   "col": 6,
   "used": true
  },
  {
   "id": 19,
   "text": "FIND THE SPELL\nWRITTEN ON A STONE\nMONUMENT UNDER THE\nWATER.",
   "row": 5,
   "col": 6,
   "used": true
  }
 ],
